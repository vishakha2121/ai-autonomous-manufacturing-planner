│ │ │ ├── digital_twin/ # SimPy simulation
│ │ │ └── utils/ # Metrics, viz
│ │ ├── core/ # Logger, exceptions
│ │ └── utils/ # Helpers
│ ├── scripts/ # Seed data, training
│ ├── tests/ # Pytest tests
│ └── data/ # SQLite DB
├── frontend/ # React + Vite
│ └── src/
│ ├── api/ # Axios clients
│ ├── components/ # Reusable components
│ ├── pages/ # Route pages
│ ├── hooks/ # Custom hooks
│ ├── context/ # React context
│ └── utils/ # Helpers
├── database/ # SQL schema
├── docs/ # Documentation
